{
  "name": "service.knowledge-loom",
  "version": "0.1.0",
  "type": "service",
  "description": "Local vault search and grounding engine. Indexes Markdown documents and exposes BM25, semantic vector, and wikilink graph search via MCP tools (loom_*). The grounding layer that connects the AI layer to operator vault content.",
  "maintainer": {
    "name": "Fritz",
    "github": "odinkirk",
    "role": "upstream-maintainer"
  },
  "source": {
    "git": "https://github.com/odinkirk/knowledge-loom"
  },
  "install": [
    "cargo build --release",
    "mkdir -p {{VAULT_PATH}}/.knowledge-loom/bin",
    "cp target/release/loom {{VAULT_PATH}}/.knowledge-loom/bin/loom",
    "KB_ROOT={{VAULT_PATH}} VAULT_PATH={{VAULT_PATH}} .knowledge-loom/bin/loom reindex"
  ],
  "mcp_config": {
    "server_name": "knowledge-loom",
    "command": "{{VAULT_PATH}}/.knowledge-loom/bin/loom",
    "args": ["serve"],
    "env": {
      "KB_ROOT": "{{VAULT_PATH}}",
      "VAULT_PATH": "{{VAULT_PATH}}"
    }
  },
  "health_endpoint": "loom index-status",
  "trust_level": "Vouched",
  "status": "Experimental",
  "required_for": ["vault-aware"],
  "provides": {
    "mcp_namespace": "loom_",
    "capabilities": [
      "full-text search (BM25 via Tantivy)",
      "semantic vector search (sqlite-vec, BGESmallENV15)",
      "wikilink graph analytics (PageRank, communities, path-finding)",
      "RRF-merged unified search",
      "surgical vault editing (read section, insert after heading, replace lines)",
      "vault file management (create, move, delete, link notes)",
      "incremental reindex on file change",
      "daemon mode with file watching"
    ]
  },
  "embedding": {
    "default": "local (BGESmallENV15, 384 dimensions)",
    "optional": ["ollama (nomic-embed-text-v1.5)", "openrouter (text-embedding-ada-002)"]
  },
  "storage": {
    "index_path": "{{VAULT_PATH}}/.knowledge-loom-index/",
    "binary_path": "{{VAULT_PATH}}/.knowledge-loom/bin/loom",
    "gitignore": [".knowledge-loom/", ".knowledge-loom-index/"]
  },
  "tags": ["grounding", "search", "mcp", "infrastructure", "core", "vault"]
}
